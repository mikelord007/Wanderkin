# Livepeer MCP endpoint (server-side only; never expose in the browser bundle)
LIVEPEER_MCP_ENDPOINT=https://agent.livepeer.org/api/mcp/full
LIVEPEER_API_KEY=
LIVEPEER_MAX_REQUEST_USD=2
LIVEPEER_MAX_WORLD_USD=8
LIVEPEER_MAX_AUTOMATIC_RETRIES=3

# Local port for the small Node API (client dev server proxies /api to this)
PORT=8787

# Where generated/downloaded assets and job records are stored durably
STORAGE_DIR=./storage
