# Livepeer MCP endpoint (server-side only; never expose in the browser bundle)
LIVEPEER_MCP_ENDPOINT=https://agent.livepeer.org/api/mcp/full
LIVEPEER_API_KEY=
LIVEPEER_MAX_REQUEST_USD=2
LIVEPEER_MAX_WORLD_USD=8
LIVEPEER_MAX_GLOBAL_USD=100
LIVEPEER_MAX_DAILY_USD=20
LIVEPEER_MAX_AUTOMATIC_RETRIES=3
PROVIDER_MAX_IN_FLIGHT=4
PROVIDER_CONCURRENCY_RETRY_SECONDS=15

# Single-instance, in-memory abuse controls (per IP + optional owner token)
BILLABLE_RATE_LIMIT=10
UPLOAD_RATE_LIMIT=30
RATE_LIMIT_WINDOW_SECONDS=60
# Set only when a trusted reverse proxy overwrites X-Forwarded-For
TRUST_PROXY_HOPS=0

# Enables GET /api/admin/spend only when non-empty
DIAGNOSTICS_TOKEN=

# Migration mode for pre-ownership storage. Keep false in production.
OBJECTQUEST_LEGACY_OPEN=false
OBJECTQUEST_SECURE_COOKIE=true

# Header-inspected decoded image limits and process-wide worst-case RGBA budget
UPLOAD_MAX_IMAGE_WIDTH=12000
UPLOAD_MAX_IMAGE_HEIGHT=12000
UPLOAD_MAX_IMAGE_PIXELS=40000000
UPLOAD_DECODE_BUDGET_BYTES=268435456

# --- Sign-in (Supabase Auth with Google) --------------------------------------
# Leave both VITE_SUPABASE_* empty to use the local stub (development only):
# "Sign in" then opens the dashboard at once as the dev user "local-dev".
# Fill them in and restart `npm run dev` to switch to real Google sign-in.
# Setup steps: nimbalyst-local/AUTH_DASHBOARD_SETUP.md (or docs in the design).
# Browser-visible (public) values only. NEVER put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: auto (default) | stub (dev builds only) | supabase
VITE_WANDERKIN_AUTH_MODE=auto

# Server: auto (default) picks supabase when a Supabase URL is set, else the
# stub outside production. stub/off are refused when NODE_ENV=production.
WANDERKIN_AUTH_MODE=auto
# Optional override; the server otherwise reuses VITE_SUPABASE_URL.
SUPABASE_URL=
# Only for older projects that still sign with the shared HS256 JWT secret.
# New projects use asymmetric keys verified through the public JWKS.
SUPABASE_JWT_SECRET=
# The Google account (verified email) that claims every world made before
# sign-in existed, on its first sign-in.
WANDERKIN_LEGACY_OWNER_EMAIL=

# Local port for the small Node API (client dev server proxies /api to this)
PORT=8787

# Where generated/downloaded assets and job records are stored durably
STORAGE_DIR=./storage
